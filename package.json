    "react-icons": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "gh-pages": "^6.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "sass": "^1.70.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
